---
import Layout from '../layouts/Layout.astro';
import PrimaryCta from '../components/PrimaryCta.astro';
---
<Layout title="Start" description="Start a conversation with EverJourneys.">
  <section class="start">
    <div class="container start__inner">
      <h1>Let's find your bearings</h1>
      <p class="subhead">
        One conversation, no pitch deck required. Tell us what feels disconnected and we'll help you see
        where it actually starts.
      </p>
      <PrimaryCta href="mailto:hello@everjourneys.com" arrow size="large">Start with a conversation</PrimaryCta>
      <p class="start__disclosure">We reply within one business day. No commitment either way.</p>
    </div>
  </section>
</Layout>

<style>
  .start {
    min-height: calc(100svh - 65px);
    display: flex;
    align-items: center;
  }

  .start__inner {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
  }

  .start__inner .subhead {
    max-width: 480px;
  }

  .start__disclosure {
    font-size: var(--text-small);
    color: rgb(17 17 17 / 60%);
    margin: 0;
  }
</style>
