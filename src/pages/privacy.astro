---
import BaseLayout from "../layouts/BaseLayout.astro";

// Verbatim transcription of the Notion "Privacy Policy" (Legal & Compliance).
// Substitutions applied per confirmed values from the site owner:
//   [PRIVACY EMAIL]            -> explore@everjourneys.com
//   [LEGAL BUSINESS NAME]      -> EverJourneys LLC
//   [BUSINESS MAILING ADDRESS] -> 811 W 7th St. Suite 9, Los Angeles, CA 90017
//   "marketing lab"            -> "growth systems consultancy" (positioning update, owner-approved)
//   effective / last-updated dates -> the constant below (was inconsistent brackets in source)
// TODO: confirm final SEO copy. TODO: set the date below to the actual launch date.
const effectiveDate = "September 6, 2026";
const lastUpdated = "September 6, 2026";

const title = "Privacy Policy — EverJourneys";
const description =
  "How EverJourneys collects, uses, discloses, and protects information collected through everjourneys.com.";

const prose =
  "mt-10 leading-relaxed text-slate-600 " +
  "[&_h2]:mt-12 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-slate-900 " +
  "[&_h3]:mt-8 [&_h3]:font-serif [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-slate-900 " +
  "[&_p]:mt-4 [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-6 " +
  "[&_hr]:mt-12 [&_hr]:border-slate-200 " +
  "[&_a]:font-medium [&_a]:text-teal-700 [&_a]:underline " +
  "[&_strong]:font-semibold [&_strong]:text-slate-800";
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <h1
      class="font-serif text-4xl font-semibold tracking-tight text-slate-900 md:text-5xl"
    >
      Privacy Policy
    </h1>
    <p class="mt-4 text-sm text-slate-500">
      <span class="font-medium text-slate-700">Effective Date:</span> {effectiveDate}<br
      />
      <span class="font-medium text-slate-700">Last Updated:</span> {lastUpdated}
    </p>

    <div class={prose}>
      <p>
        EverJourneys ("EverJourneys," "we," "us," or "our") respects your privacy
        and is committed to being transparent about how we collect, use,
        disclose, and protect information.
      </p>
      <p>
        This Privacy Policy applies to information collected through the
        EverJourneys website, including <strong>everjourneys.com</strong>, our
        forms, communications, and other online services that link to this
        Privacy Policy.
      </p>
      <p>
        EverJourneys is a growth systems consultancy focused on helping
        businesses build clearer, more connected marketing systems. Our services
        may include marketing strategy, user experience, brand messaging, website
        and conversion optimization, paid advertising, analytics, CRM,
        automation, artificial intelligence, and related marketing technology.
      </p>
      <p>
        By using our website, you acknowledge the practices described in this
        Privacy Policy.
      </p>

      <h2>1. Information We Collect</h2>
      <p>
        Depending on how you interact with EverJourneys, we may collect the
        following categories of information.
      </p>

      <h3>Information You Provide</h3>
      <p>You may voluntarily provide information when you:</p>
      <ul>
        <li>Submit a contact or inquiry form</li>
        <li>Complete a marketing discovery or assessment form</li>
        <li>Request a consultation</li>
        <li>Request information about our services</li>
        <li>Subscribe to communications</li>
        <li>Communicate with us by email, phone, or other channels</li>
        <li>Enter into a business relationship with us</li>
        <li>Provide information necessary to perform services for your business</li>
      </ul>
      <p>This information may include:</p>
      <ul>
        <li>Name</li>
        <li>Business name</li>
        <li>Email address</li>
        <li>Phone number</li>
        <li>Website address</li>
        <li>Job title or role</li>
        <li>Business and marketing information</li>
        <li>Information about your business goals and challenges</li>
        <li>Budget or marketing-spend information</li>
        <li>Information submitted through discovery or intake forms</li>
        <li>Communications and correspondence with us</li>
        <li>Other information you voluntarily provide</li>
      </ul>

      <h3>Information Collected Automatically</h3>
      <p>
        When you visit our website, certain information may be collected
        automatically through cookies, analytics tools, advertising technologies,
        and similar technologies.
      </p>
      <p>This may include:</p>
      <ul>
        <li>IP address</li>
        <li>Browser type</li>
        <li>Device type</li>
        <li>Operating system</li>
        <li>Approximate location derived from IP address</li>
        <li>Pages visited</li>
        <li>Referring website</li>
        <li>Date and time of visits</li>
        <li>Website interactions</li>
        <li>Traffic and engagement information</li>
        <li>Advertising and campaign information</li>
        <li>Other technical information made available by your browser or device</li>
      </ul>
      <p>
        We may use technologies such as cookies, pixels, tags, scripts, and
        analytics tools to understand how visitors use our website and to improve
        our marketing and website performance.
      </p>

      <h2>2. How We Collect Information</h2>
      <p>We may collect information:</p>
      <ul>
        <li>Directly from you</li>
        <li>From your interactions with our website</li>
        <li>Through forms and questionnaires</li>
        <li>Through email or other communications</li>
        <li>Automatically through website technologies</li>
        <li>Through analytics and advertising platforms</li>
        <li>From publicly available business information</li>
        <li>From business partners or service providers when appropriate</li>
        <li>
          From clients when information is provided to us as part of performing
          services
        </li>
      </ul>

      <h2>3. How We Use Information</h2>
      <p>
        We may use information for legitimate business and operational purposes,
        including to:
      </p>
      <ul>
        <li>Respond to inquiries</li>
        <li>Schedule consultations</li>
        <li>Provide requested information</li>
        <li>Evaluate whether our services may be appropriate for your business</li>
        <li>Provide and manage services</li>
        <li>Communicate with clients and prospects</li>
        <li>Develop marketing strategies</li>
        <li>Analyze website and marketing performance</li>
        <li>Improve our website, services, and customer experience</li>
        <li>Conduct analytics and reporting</li>
        <li>Manage advertising campaigns</li>
        <li>Measure advertising effectiveness</li>
        <li>Maintain and improve our marketing systems</li>
        <li>Manage CRM and business operations</li>
        <li>Automate business processes</li>
        <li>Detect, prevent, and address security or technical issues</li>
        <li>Comply with legal obligations</li>
        <li>Protect our rights and interests</li>
        <li>Perform other purposes disclosed to you at or before collection</li>
      </ul>
      <p>
        We do not use personal information for purposes that are materially
        different from the purposes disclosed to you without providing additional
        notice where required by applicable law.
      </p>

      <h2>4. Marketing, Analytics, and Advertising</h2>
      <p>
        Because EverJourneys provides marketing and growth-system services, our
        website may use analytics, advertising, and marketing technologies.
      </p>
      <p>These technologies may help us understand:</p>
      <ul>
        <li>How visitors find our website</li>
        <li>Which pages visitors view</li>
        <li>How visitors interact with our website</li>
        <li>Which marketing channels generate traffic</li>
        <li>Whether advertising campaigns are effective</li>
        <li>Which content or experiences are most useful</li>
        <li>How visitors move through our website</li>
      </ul>
      <p>
        These technologies may include services such as Google Analytics, Google
        Ads, Google Tag Manager, CRM platforms, form providers, and other
        business or marketing technology.
      </p>
      <p>
        Third-party platforms may collect information according to their own
        privacy policies.
      </p>

      <h2>5. Cookies and Similar Technologies</h2>
      <p>We may use cookies and similar technologies to:</p>
      <ul>
        <li>Operate our website</li>
        <li>Remember preferences</li>
        <li>Understand website usage</li>
        <li>Analyze traffic</li>
        <li>Measure marketing performance</li>
        <li>Improve website functionality</li>
        <li>Support advertising and remarketing where applicable</li>
      </ul>
      <p>
        You can control cookies through your browser settings and, where
        applicable, through our website's privacy or cookie controls.
      </p>
      <p>Disabling certain cookies may affect website functionality.</p>

      <h2>6. How We Share Information</h2>
      <p>
        We may disclose information to third parties when reasonably necessary to
        operate our business, provide services, or fulfill the purposes described
        in this Privacy Policy.
      </p>
      <p>These parties may include:</p>
      <ul>
        <li>Website hosting providers</li>
        <li>CRM providers</li>
        <li>Analytics providers</li>
        <li>Advertising platforms</li>
        <li>Marketing technology providers</li>
        <li>Form and scheduling providers</li>
        <li>Email service providers</li>
        <li>Automation platforms</li>
        <li>Cloud storage providers</li>
        <li>Technology and software providers</li>
        <li>Professional advisors</li>
        <li>Legal, accounting, or financial service providers</li>
        <li>Government authorities when legally required</li>
      </ul>
      <p>We may also disclose information:</p>
      <ul>
        <li>To protect our rights, property, or safety</li>
        <li>To investigate fraud or security issues</li>
        <li>To enforce our agreements</li>
        <li>
          In connection with a merger, acquisition, financing, restructuring,
          sale, or other business transaction
        </li>
        <li>When otherwise permitted or required by law</li>
      </ul>
      <p>
        We do not sell personal information as that term is traditionally
        understood.
      </p>
      <p>
        If our use of advertising, analytics, or other technologies constitutes
        "sharing" or another regulated disclosure under applicable California
        privacy law, we will provide applicable rights and choices as required by
        law.
      </p>

      <h2>7. Client Information</h2>
      <p>
        EverJourneys may receive information from clients in connection with
        marketing, analytics, CRM, website, advertising, automation, or other
        services.
      </p>
      <p>
        When we process information on behalf of a client, that information may
        be processed according to the client's instructions and agreements with
        EverJourneys.
      </p>
      <p>
        In those situations, the client may be responsible for determining the
        appropriate legal basis, notices, consents, and consumer rights
        applicable to its own customers and data.
      </p>
      <p>
        EverJourneys does not independently determine the purposes for which
        client-controlled customer information is collected when acting solely as
        a service provider or contractor.
      </p>

      <h2>8. Artificial Intelligence</h2>
      <p>
        EverJourneys may use artificial intelligence and machine-learning
        technologies as part of its internal operations and service delivery.
      </p>
      <p>AI may be used for purposes such as:</p>
      <ul>
        <li>Research</li>
        <li>Analysis</li>
        <li>Marketing strategy</li>
        <li>Content development</li>
        <li>Data organization</li>
        <li>Workflow automation</li>
        <li>Reporting</li>
        <li>Business intelligence</li>
        <li>Customer journey analysis</li>
        <li>Marketing optimization</li>
      </ul>
      <p>
        Where appropriate, information may be processed through third-party AI or
        technology providers.
      </p>
      <p>
        We take reasonable steps to use information in accordance with our
        agreements, applicable law, and the purpose for which it was collected.
      </p>
      <p>
        You should not submit highly sensitive personal information through our
        website forms unless specifically requested and appropriate.
      </p>

      <h2>9. Data Retention</h2>
      <p>
        We retain personal information only for as long as reasonably necessary
        to fulfill the purposes for which it was collected, provide services,
        maintain business records, resolve disputes, enforce agreements, comply
        with legal obligations, and otherwise operate our business.
      </p>
      <p>Retention periods may vary depending on:</p>
      <ul>
        <li>The nature of the information</li>
        <li>The purpose for which it was collected</li>
        <li>
          Whether you are a prospect, client, former client, or website visitor
        </li>
        <li>Legal and contractual requirements</li>
        <li>Security and operational needs</li>
      </ul>

      <h2>10. Data Security</h2>
      <p>
        We use reasonable administrative, technical, and organizational measures
        designed to protect personal information from unauthorized access,
        disclosure, alteration, or destruction.
      </p>
      <p>
        However, no website, transmission method, or electronic storage system
        can be guaranteed to be completely secure.
      </p>

      <h2>11. Your California Privacy Rights</h2>
      <p>
        If you are a California resident and applicable California privacy law
        applies to our processing of your information, you may have rights
        including:
      </p>
      <ul>
        <li>
          The right to know about personal information we collect, use, disclose,
          or otherwise process
        </li>
        <li>
          The right to request deletion of personal information, subject to legal
          exceptions
        </li>
        <li>
          The right to request correction of inaccurate personal information
        </li>
        <li>
          The right to opt out of certain sales or sharing of personal
          information
        </li>
        <li>
          The right to limit certain uses or disclosures of sensitive personal
          information where applicable
        </li>
        <li>
          The right not to receive discriminatory treatment for exercising
          applicable privacy rights
        </li>
      </ul>
      <p>
        California law also recognizes user-enabled global privacy controls and
        other opt-out preference signals in certain circumstances.
      </p>
      <p>
        These rights are subject to applicable legal exceptions and verification
        requirements.
      </p>

      <h2>12. How to Exercise Your Privacy Rights</h2>
      <p>To submit a privacy request, contact us at:</p>
      <p>
        <strong>Email:</strong> explore@everjourneys.com<br />
        <strong>Business Name:</strong> EverJourneys LLC<br />
        <strong>Mailing Address:</strong> 811 W 7th St. Suite 9, Los Angeles, CA 90017
      </p>
      <p>
        Please include enough information for us to reasonably verify your
        identity and understand your request.
      </p>
      <p>
        We may need to verify your identity before fulfilling certain requests.
        Verification requirements may vary depending on the nature of the request
        and the sensitivity of the information involved.
      </p>
      <p>
        You may use an authorized agent to submit a request where permitted by
        applicable law.
      </p>
      <p>
        We will process verified requests within the time required by applicable
        law.
      </p>

      <h2>13. Non-Discrimination</h2>
      <p>
        We will not unlawfully discriminate against you for exercising privacy
        rights provided by applicable law.
      </p>

      <h2>14. Children's Privacy</h2>
      <p>
        Our website and services are intended for businesses and adults and are
        not directed toward children under 13.
      </p>
      <p>
        We do not knowingly collect personal information from children under 13
        through our website.
      </p>
      <p>
        If you believe a child has provided personal information to us, please
        contact us so that we can take appropriate action.
      </p>

      <h2>15. Third-Party Websites</h2>
      <p>
        Our website may contain links to third-party websites, platforms, or
        services.
      </p>
      <p>
        We are not responsible for the privacy practices, content, or security
        of third-party websites.
      </p>
      <p>
        We encourage you to review the privacy policies of any third-party
        services you visit.
      </p>

      <h2>16. Changes to This Privacy Policy</h2>
      <p>
        We may update this Privacy Policy from time to time to reflect changes in
        our business, technology, services, legal requirements, or privacy
        practices.
      </p>
      <p>
        When we update this Privacy Policy, we will revise the "Last Updated"
        date above.
      </p>
      <p>
        Where required by law, we will provide additional notice of material
        changes.
      </p>

      <h2>17. Contact Us</h2>
      <p>
        If you have questions, concerns, or requests regarding this Privacy
        Policy or our privacy practices, contact:
      </p>
      <p>
        <strong>EverJourneys LLC</strong><br />
        <strong>Email:</strong> explore@everjourneys.com<br />
        <strong>Address:</strong> 811 W 7th St. Suite 9, Los Angeles, CA 90017
      </p>

      <hr />
      <p><strong>Last Updated:</strong> {lastUpdated}</p>
    </div>
  </article>
</BaseLayout>
