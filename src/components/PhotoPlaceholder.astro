---
// Placeholder standing in for the brand guide's duotone landscape photography (§1.4, open item #4 —
// no raw photo asset library was supplied with the guide). Swap the background for a real desaturated
// duotone crop (mountains/coastline/figure) once sourced; the ink/tan/slate duotone gradient approximates
// the treatment so layout and cropping can be reviewed now.
interface Props {
  class?: string;
  ratio?: string;
}

const { class: className, ratio = '4 / 5' } = Astro.props;
---
<div class:list={['photo-placeholder', className]} style={`aspect-ratio: ${ratio};`}>
  <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="duotone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3D5A6A" />
        <stop offset="55%" stop-color="#7A8A85" />
        <stop offset="100%" stop-color="#111111" />
      </linearGradient>
    </defs>
    <rect width="400" height="500" fill="url(#duotone)" />
    <path d="M0 340 L90 220 L160 300 L230 180 L300 310 L400 240 L400 500 L0 500 Z" fill="#111111" opacity="0.55" />
    <path d="M0 400 L120 320 L210 380 L400 300 L400 500 L0 500 Z" fill="#111111" opacity="0.35" />
  </svg>
</div>

<style>
  .photo-placeholder {
    overflow: hidden;
    border-radius: var(--radius-sharp);
  }

  .photo-placeholder svg {
    width: 100%;
    height: 100%;
  }
</style>
