---
// 3-card variant, §2.5 — larger card, number badge, room for quote + body + destination tag.
import DestinationTag from './DestinationTag.astro';

interface CardItem {
  number: string;
  title: string;
  quote?: string;
  body: string;
  destination?: { kind: 'ends' | 'continues' | 'jumps'; label: string };
}

interface Props {
  items: CardItem[];
  feature?: boolean; // "Three Ways to Work" treatment: larger internal padding, 48px numerals
}

const { items, feature = false } = Astro.props;
---
<div class:list={['card3-grid', { 'card3-grid--feature': feature }]}>
  {items.map((item) => (
    <div class="card card3">
      <span class="card3__number">{item.number}</span>
      <h3 class="card3__title">{item.title}</h3>
      {item.quote && <p class="card3__quote">{item.quote}</p>}
      <p class="card3__body">{item.body}</p>
      {item.destination && (
        <div class="card3__destination">
          <DestinationTag kind={item.destination.kind} label={item.destination.label} />
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .card3-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .card3-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .card3 {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card3__number {
    font-family: var(--font-display);
    font-size: 32px;
    color: var(--color-orange);
    line-height: 1;
  }

  .card3-grid--feature .card3__number {
    font-size: 48px;
  }

  .card3-grid--feature .card {
    padding: var(--space-4);
  }

  @media (min-width: 640px) {
    .card3-grid--feature .card {
      padding: var(--space-section-tight-mobile);
    }
  }

  .card3__title {
    margin: 0;
  }

  .card3__quote {
    font-size: var(--text-body-lg);
    font-style: italic;
    color: var(--color-ink);
    margin: 0;
  }

  .card3__body {
    font-size: var(--text-body);
    color: rgb(17 17 17 / 80%);
    margin: 0;
  }

  .card3__destination {
    margin-top: auto;
    padding-top: var(--space-2);
  }
</style>
