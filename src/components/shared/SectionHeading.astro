---
interface Props {
  eyebrow: string;
  headline: string;
  subhead?: string;
}

const { eyebrow, headline, subhead } = Astro.props;
---

<div class="max-w-3xl">
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700">
    {eyebrow}
  </p>
  <h2
    class="mt-3 font-serif text-3xl font-semibold tracking-tight text-slate-900 md:text-4xl"
  >
    {headline}
  </h2>
  {subhead && <p class="mt-4 text-lg text-slate-600">{subhead}</p>}
</div>
