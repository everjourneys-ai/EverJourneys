---
// V1 placeholder — not final art. A circle with N/E/S/W tick marks and a
// center label, just enough of a shape to hold the layout. To be replaced.
interface Props {
  variant: "mini" | "full";
}

const { variant } = Astro.props;
const dimension = variant === "full" ? 260 : 120;
---

<svg
  role="img"
  aria-label="EverCompass diagram (placeholder)"
  width={dimension}
  height={dimension}
  viewBox="0 0 200 200"
  class="text-slate-300"
>
  <circle
    cx="100"
    cy="100"
    r="82"
    fill="none"
    stroke="currentColor"
    stroke-width="2"></circle>
  <!-- N / E / S / W ticks -->
  <line x1="100" y1="10" x2="100" y2="34" stroke="currentColor" stroke-width="3"
  ></line>
  <line x1="190" y1="100" x2="166" y2="100" stroke="currentColor" stroke-width="3"
  ></line>
  <line x1="100" y1="190" x2="100" y2="166" stroke="currentColor" stroke-width="3"
  ></line>
  <line x1="10" y1="100" x2="34" y2="100" stroke="currentColor" stroke-width="3"
  ></line>
  <text
    x="100"
    y="105"
    text-anchor="middle"
    class="fill-slate-500 font-serif text-[15px]">EverCompass</text
  >
</svg>
