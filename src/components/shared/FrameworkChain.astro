---
// Shared visual for the Problem → Diagnosis → Action → Result → Next Move
// framework. Used in both ResultsIntro and ProblemToResult so the two
// near-identical diagrams in the source content stay one component.
// Placeholder-quality for V1 — simple CSS chain, no animation.
interface Props {
  steps: { label: string; question: string }[];
}

const { steps } = Astro.props;
---

<ol class="flex flex-col gap-3 md:flex-row md:items-stretch md:gap-2">
  {
    steps.map((step, i) => (
      <li class="flex flex-col md:flex-1 md:flex-row md:items-center">
        <div class="flex-1 rounded-xl border border-slate-300 bg-white p-4">
          <p class="font-serif text-base font-semibold text-slate-900">
            {step.label}
          </p>
          <p class="mt-1 text-sm text-slate-500">{step.question}</p>
        </div>
        {i < steps.length - 1 && (
          <span
            aria-hidden="true"
            class="mx-auto my-1 text-lg text-teal-700 md:mx-1 md:my-0"
          >
            <span class="md:hidden">&darr;</span>
            <span class="hidden md:inline">&rarr;</span>
          </span>
        )}
      </li>
    ))
  }
</ol>
