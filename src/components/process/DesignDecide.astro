---
import SectionHeading from "../shared/SectionHeading.astro";
import { decidePaths } from "../../data/process";
---

<section class="border-t border-slate-100 bg-stone-50">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="Stage 3–4 · Powered by EverCompass"
      headline="A specific plan. Then you choose how far to take it."
      subhead="EverCompass turns the diagnosis into a plan — you decide how much of it EverJourneys builds."
    />
    <div class="mt-8 max-w-3xl space-y-5 text-lg text-slate-600">
      <p>
        <strong class="font-semibold text-slate-900"
          >Design — "Show me what I need."</strong
        > Using EverCompass, we determine what should be built, why, and in what order.
        This produces your Growth System Blueprint — your priorities, the components
        they call for, and how they connect, specific to your business, not a generic
        package.
      </p>
      <p>
        <strong class="font-semibold text-slate-900"
          >Decide — "What do I want you to do?"</strong
        > You choose how you want to work with us. These are flexible entry points,
        not required packages — and each one leads somewhere different, as shown above.
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        decidePaths.map((path) => (
          <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="font-serif text-xl font-semibold text-slate-900">
              {path.name}
            </h3>
            <p class="mt-1 text-sm italic text-teal-700">"{path.quote}"</p>
            <p class="mt-4 flex-1 text-slate-600">{path.body}</p>
            <p class="mt-5 inline-flex w-fit items-center rounded-full border border-teal-700 bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-900">
              {path.destination}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
