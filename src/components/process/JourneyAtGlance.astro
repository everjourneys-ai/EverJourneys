---
import SectionHeading from "../shared/SectionHeading.astro";

// V1 placeholder-quality diagram (same standard as CompassDiagram): the
// branching logic matters more than polish. Built with layout primitives
// rather than hand-placed SVG so it stays legible when it stacks on mobile.
//
// It must make three things obvious without a caption:
//  1. Decide is a FORK — three paths lead out of it.
//  2. Strategy is a valid ENDPOINT, not a dead end.
//  3. Optimization SKIPS Build/Launch — its path is visibly shorter than
//     Execution's (2 stages vs 4).

const spine = ["Problem", "Discover", "Diagnose", "Design", "Decide"];

const paths = [
  {
    name: "Strategy",
    quote: "Give me the blueprint.",
    stages: [] as string[],
    endpoint: "Growth System Blueprint delivered",
    note: "A deliberate stopping point — this path can end here, or continue to Execution later.",
  },
  {
    name: "Execution",
    quote: "Build it for me.",
    stages: ["Build", "Launch", "Optimize", "Grow"],
    endpoint: null,
    note: null,
  },
  {
    name: "Optimization",
    quote: "Make it work better.",
    stages: ["Optimize", "Grow"],
    endpoint: null,
    note: "Skips Build & Launch — the system already exists.",
  },
];
---

<section class="border-t border-slate-100 bg-stone-50">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="The Full Picture"
      headline="Eight stages. One connected process."
      subhead="Where you enter and how far you go depends on what you choose at Decide. Here's what happens at each stage."
    />

    <div class="mt-12">
      <!-- Spine: Problem → Discover → Diagnose → Design → Decide -->
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-3">
        {
          spine.map((stage, i) => (
            <li class="flex items-center gap-2">
              <span
                class:list={[
                  "inline-flex items-center rounded-lg border px-4 py-2 text-sm font-semibold",
                  stage === "Decide"
                    ? "border-teal-700 bg-teal-700 text-white"
                    : "border-slate-300 bg-white text-slate-800",
                ]}
              >
                {stage}
              </span>
              {i < spine.length - 1 && (
                <span aria-hidden="true" class="text-slate-400">
                  &rarr;
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <p class="mt-3 text-sm font-medium text-teal-700">
        Decide is a fork &mdash; pick one of three paths:
      </p>

      <!-- Fork connector (desktop only) -->
      <div aria-hidden="true" class="mt-2 hidden md:grid md:grid-cols-3">
        <div class="flex flex-col items-center">
          <div class="h-4 w-px bg-slate-300"></div>
          <div class="h-px w-1/2 self-end bg-slate-300"></div>
          <div class="h-4 w-px bg-slate-300"></div>
        </div>
        <div class="flex flex-col items-center">
          <div class="h-4 w-px bg-slate-300"></div>
          <div class="h-px w-full bg-slate-300"></div>
          <div class="h-4 w-px bg-slate-300"></div>
        </div>
        <div class="flex flex-col items-center">
          <div class="h-4 w-px bg-slate-300"></div>
          <div class="h-px w-1/2 self-start bg-slate-300"></div>
          <div class="h-4 w-px bg-slate-300"></div>
        </div>
      </div>

      <!-- Three paths — compared by stage-stack length, not card chrome -->
      <div class="mt-4 grid gap-8 md:grid-cols-3 md:items-start">
        {
          paths.map((path) => (
            <div>
              <p class="font-serif text-lg font-semibold text-slate-900">
                {path.name}
              </p>
              <p class="mt-1 text-sm italic text-teal-700">"{path.quote}"</p>

              <div class="mt-4 space-y-1.5">
                {path.stages.map((stage, i) => (
                  <>
                    <span class="block rounded-lg border border-slate-300 bg-white px-4 py-2 text-center text-sm font-semibold text-slate-800">
                      {stage}
                    </span>
                    {i < path.stages.length - 1 && (
                      <span
                        aria-hidden="true"
                        class="mx-auto block w-fit leading-none text-slate-400"
                      >
                        &darr;
                      </span>
                    )}
                  </>
                ))}

                {path.endpoint && (
                  <span class="block rounded-lg border-2 border-teal-700 bg-teal-50 px-4 py-3 text-center text-sm font-semibold text-teal-900">
                    &check; {path.endpoint}
                    <span class="mt-1 block text-xs font-normal text-teal-800">
                      end of path
                    </span>
                  </span>
                )}
              </div>

              {path.note && (
                <p class="mt-3 text-xs text-slate-500">{path.note}</p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
