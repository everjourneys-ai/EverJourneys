---
import CoordinateTag from './CoordinateTag.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/ever-compass', label: 'EverCompass' },
  { href: '/process', label: 'Process' },
  { href: '/results', label: 'Results' },
  { href: '/start', label: 'Start with a conversation' },
];
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__row">
    <div class="footer__brand">
      <p class="footer__logo">EverJourneys</p>
      <p class="footer__tag">Clarity Creates Momentum</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer__links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="footer__meta">
      <p class="footer__copy">&copy; {year} EverJourneys</p>
      <CoordinateTag />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-size: 20px;
    margin: 0 0 4px;
  }

  .footer__tag {
    margin: 0;
    font-size: var(--text-small);
    color: rgb(243 239 233 / 65%);
  }

  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .footer__links a {
    text-decoration: none;
    font-size: var(--text-small);
    color: rgb(243 239 233 / 85%);
  }

  .footer__links a:hover {
    color: var(--color-orange);
  }

  .footer__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .footer__copy {
    font-size: var(--text-small);
    color: rgb(243 239 233 / 65%);
    margin: 0;
  }

  .footer__meta :global(.coordinate-tag) {
    color: rgb(243 239 233 / 45%);
  }

  @media (min-width: 768px) {
    .footer__meta {
      align-items: flex-end;
      text-align: right;
    }
  }
</style>
