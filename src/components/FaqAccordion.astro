---
// FAQ accordion, §2.4 — native <details>/<summary>, no JS.
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary class="faq__question">
        <span>{item.question}</span>
        <svg class="faq__chevron" width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true">
          <path d="M1 1L7 7L13 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <p class="faq__answer">{item.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
  }

  .faq__item {
    border-bottom: 1px solid var(--color-tan);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-3);
    font-size: var(--text-body-lg);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__chevron {
    flex-shrink: 0;
    color: var(--color-ink);
    transition: transform var(--motion-cta) ease-out;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__answer {
    font-size: var(--text-body);
    color: rgb(17 17 17 / 70%);
    padding-top: var(--space-2);
    padding-bottom: var(--space-3);
    margin: 0;
  }

  @supports (interpolate-size: allow-keywords) {
    .faq__item {
      interpolate-size: allow-keywords;
    }

    .faq__item::details-content {
      opacity: 0;
      height: 0;
      overflow: hidden;
      transition: height var(--motion-reveal) ease-out, opacity var(--motion-reveal) ease-out, content-visibility var(--motion-reveal) allow-discrete;
    }

    .faq__item[open]::details-content {
      opacity: 1;
      height: auto;
    }
  }
</style>
