---
import SectionHeading from "../shared/SectionHeading.astro";
import { inActionSteps } from "../../data/evercompass";
---

<section class="border-t border-slate-100 bg-white">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <p
      class="inline-flex items-center rounded-full border border-slate-300 bg-stone-100 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-600"
    >
      A Typical Scenario
    </p>
    <div class="mt-6">
      <SectionHeading
        eyebrow="One Example, Not a Formula"
        headline="Here's what that reasoning looks like."
        subhead="One example of how EverCompass reasons from a stated problem to a specific fix. Every business's path through this looks different."
      />
    </div>
    <ol class="mt-12 space-y-6 border-l border-slate-200 pl-6">
      {
        inActionSteps.map((step, i) => (
          <li class="relative">
            <span
              class="absolute -left-[2.1rem] flex h-7 w-7 items-center justify-center rounded-full border border-teal-700 bg-white text-sm font-semibold text-teal-700"
            >
              {i + 1}
            </span>
            <h3 class="font-serif text-lg font-semibold text-slate-900">
              {step.label}
            </h3>
            <p class="mt-1 text-slate-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
