---
import SectionHeading from "../shared/SectionHeading.astro";
import { journeyStages } from "../../data/evercompass";
---

<section class="border-t border-slate-100 bg-stone-50">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="What EverCompass Looks At"
      headline="What EverCompass looks at."
      subhead="How customers discover you, engage with you, decide to buy, and stay — and where that movement is actually breaking down."
    />
    <p class="mt-8 max-w-3xl text-lg text-slate-600">
      EverCompass examines a business across four stages: Attract, Engage,
      Convert, Retain — and finds out where the constraint actually is, which
      isn't always the stage that feels most visible. These four stages are a
      lens for locating a problem, not a claim that every growth issue fits into
      one of them.
    </p>
    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        journeyStages.map((stage, i) => (
          <li class="rounded-xl border border-slate-200 bg-white p-6">
            <span class="text-sm font-semibold text-teal-700">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-2 font-serif text-xl font-semibold text-slate-900">
              {stage.name}
            </h3>
            <p class="mt-2 text-slate-600">{stage.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
