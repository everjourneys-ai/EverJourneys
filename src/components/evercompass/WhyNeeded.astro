---
import SectionHeading from "../shared/SectionHeading.astro";
---

<section class="border-t border-slate-100 bg-stone-50">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="Diagnosis Before recommendation"
      headline="Nothing gets recommended before it's been diagnosed."
      subhead="EverCompass starts with the problem, not a service."
    />
    <p class="mt-8 max-w-3xl text-lg text-slate-600">
      EverCompass exists so that what gets built is a response to what's actually
      constraining your growth — not a guess dressed up as a recommendation.
    </p>
  </div>
</section>
