---
import SectionHeading from "../shared/SectionHeading.astro";
import { processSteps } from "../../data/home";
---

<section class="border-t border-slate-100 bg-white">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <SectionHeading
      eyebrow="How It Works"
      headline="A clear process, from first conversation to ongoing improvement."
    />
    <ol class="mt-12 grid gap-8 md:grid-cols-5">
      {
        processSteps.map((step, i) => (
          <li class="relative">
            <div class="flex h-9 w-9 items-center justify-center rounded-full border border-teal-700 text-sm font-semibold text-teal-700">
              {i + 1}
            </div>
            <h3 class="mt-3 font-serif text-lg font-semibold text-slate-900">
              {step.name}
            </h3>
            <p class="mt-2 text-sm text-slate-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
