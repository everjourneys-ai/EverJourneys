---
import { primaryCtaHref } from "../../data/site";
---

<section class="bg-white">
  <div class="mx-auto max-w-5xl px-6 py-24 md:py-32">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700">
      For businesses whose marketing feels disconnected
    </p>
    <h1
      class="mt-4 max-w-4xl font-serif text-4xl font-semibold tracking-tight text-slate-900 md:text-6xl"
    >
      Turn scattered marketing into a growth system that works.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600 md:text-xl">
      EverJourneys helps you understand what's actually holding growth back, then
      builds and improves the connected system that fixes it.
    </p>
    <div class="mt-10">
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center rounded-md bg-teal-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-teal-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700"
      >
        Start with a conversation
      </a>
    </div>
  </div>
</section>
