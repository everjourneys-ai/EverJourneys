---
import { waysToWork } from "../../data/home";
import { primaryCtaHref } from "../../data/site";
---

<section class="border-t border-slate-800 bg-slate-900 text-slate-100">
  <div class="mx-auto max-w-5xl px-6 py-24 md:py-32">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-300">
      How You Can Work With Us
    </p>
    <h2
      class="mt-3 max-w-3xl font-serif text-3xl font-semibold tracking-tight text-white md:text-4xl"
    >
      Three ways to work with EverJourneys. Start wherever you are.
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-slate-300">
      You don't have to buy everything at once — or know exactly what you need
      before you start.
    </p>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        waysToWork.map((way) => (
          <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-6">
            <h3 class="font-serif text-xl font-semibold text-white">
              {way.name}
            </h3>
            <p class="mt-2 text-sm italic text-teal-300">“{way.quote}”</p>
            <p class="mt-4 text-slate-300">{way.body}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-12">
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-sm font-semibold text-slate-900 shadow-sm transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Not sure where to start? Let's figure it out together.
      </a>
    </div>
  </div>
</section>
