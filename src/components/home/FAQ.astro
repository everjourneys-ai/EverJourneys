---
import SectionHeading from "../shared/SectionHeading.astro";
import { faqItems } from "../../data/home";
---

<section class="border-t border-slate-100 bg-stone-50">
  <div class="mx-auto max-w-5xl px-6 py-20 md:py-28">
    <SectionHeading eyebrow="FAQ" headline="Questions you might have" />
    <div class="mt-10 max-w-3xl divide-y divide-slate-200 border-y border-slate-200">
      {
        faqItems.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium text-slate-900 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span
                aria-hidden="true"
                class="shrink-0 text-teal-700 transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-slate-600">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
