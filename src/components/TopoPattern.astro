---
// §1.4 — low-opacity topographic contour lines + sparse orange dot-grid, hero/divider backgrounds only.
---
<svg class="topo-pattern" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <g fill="none" stroke="var(--color-ink)" stroke-width="1" opacity="0.08">
    <path d="M-20 460 Q 200 400 400 460 T 820 440" />
    <path d="M-20 500 Q 200 450 400 500 T 820 480" />
    <path d="M-20 540 Q 200 500 400 540 T 820 520" />
    <path d="M-20 100 Q 250 40 500 100 T 820 60" />
    <path d="M-20 140 Q 250 90 500 140 T 820 100" />
  </g>
  <g fill="var(--color-orange)" opacity="0.18">
    <circle cx="60" cy="60" r="2" /><circle cx="110" cy="60" r="2" /><circle cx="160" cy="60" r="2" />
    <circle cx="60" cy="110" r="2" /><circle cx="110" cy="110" r="2" /><circle cx="160" cy="110" r="2" />
    <circle cx="700" cy="500" r="2" /><circle cx="750" cy="500" r="2" />
    <circle cx="700" cy="550" r="2" /><circle cx="750" cy="550" r="2" />
  </g>
</svg>

<style>
  .topo-pattern {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
</style>
