---
// 4-item grid, §2.5 — Customer Journey / Four Capabilities: compact, icon-led, deliberately menu-like.
interface CardItem {
  icon: string; // inline SVG markup from src/components/icons
  title: string;
  body: string;
}

interface Props {
  items: CardItem[];
}

const { items } = Astro.props;
---
<div class="card4-grid">
  {items.map((item) => (
    <div class="card card4">
      <span class="card4__icon" set:html={item.icon} />
      <h3 class="card4__title">{item.title}</h3>
      <p class="card4__body">{item.body}</p>
    </div>
  ))}
</div>

<style>
  .card4-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .card4-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .card4-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card4 {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .card4__icon {
    color: var(--color-ink);
    width: 28px;
    height: 28px;
  }

  .card4__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .card4__title {
    margin: 0;
    font-size: var(--text-h3);
  }

  .card4__body {
    font-size: var(--text-small);
    color: rgb(17 17 17 / 75%);
    margin: 0;
  }
</style>
