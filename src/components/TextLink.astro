---
// Secondary/body-copy CTA, §2.2 — subordinate to the primary button, arrow is part of the copy.
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---
<a href={href} class:list={['text-link', className]}>
  <slot />
</a>

<style>
  .text-link {
    color: var(--color-slate);
    font-weight: 500;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }
</style>
